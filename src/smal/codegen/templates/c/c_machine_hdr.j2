{% from "macros/c/c_autogen_banner_state_machine.j2" import c_autogen_banner_state_machine %}
{% from "macros/c/c_machine_constants.j2" import c_machine_constants %}
{% from "macros/c/c_machine_state_table_entry.j2" import c_machine_state_table_entry %}
{% from "macros/c/c_machine_struct.j2" import c_machine_struct %}
{% from "macros/c/c_machine_version.j2" import c_machine_version %}
{% from "macros/c/c_machine_state_transition_table.j2" import c_machine_state_transition_table %}
{% from "macros/c/c_machine_actions.j2" import c_machine_actions %}
{% from "macros/c/c_machine_guards.j2" import c_machine_guards %}
{% from "macros/c/c_machine_context.j2" import c_machine_context %}
{% from "macros/c/c_enum.j2" import c_enum %}
{{ c_autogen_banner_state_machine(machine) }}
#ifndef {{ machine.metadata.header_guard }}
#define {{ machine.metadata.header_guard }}

#include <stdint.h>
#include <stddef.h>
#include <stdbool.h>

{{ c_machine_version(machine) }}

{% if machine.constants %}
// CONSTANTS
{{ c_machine_constants(machine) }}
{% endif %}

{% if machine.states %}
// STATES
{{ c_enum(machine.states_enum_spec(include_null=true, include_count=true)) }}
{% endif %}

{% if machine.events %}
// EVENTS
{{ c_enum(machine.events_enum_spec(include_null=true, include_count=true)) }}
{% endif %}

{% if machine.errors %}
// ERRORS
{{ c_enum(machine.errors_enum_spec(include_null=true, include_count=true)) }}
{% endif %}

// ENUMS
{% for enum in machine.enums %}
{{ c_enum(enum.specification(prefix=enum.name)) }}
{% endfor %}

{{ c_machine_context(machine) }}

{{ c_machine_struct(machine) }}

{{ c_machine_state_table_entry(machine, machine.longest_action_chain) }}

{% if machine.guards %}
// GUARDS
{{ c_machine_guards(machine) }}
{% endif %}

// ACTIONS
{{ c_machine_actions(machine) }}

// STATE TABLE
{{ c_machine_state_transition_table(machine) }}

#endif // {{ machine.metadata.header_guard }}
