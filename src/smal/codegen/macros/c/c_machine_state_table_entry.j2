{% macro c_machine_state_table_entry(machine, max_actions) %}
/* All actions take the state machine itself as an argument and return nothing. */
typedef void (*{{ machine.name | lower }}_action_t)({{ machine.name | lower }}_state_machine_t *state_machine, void *user_ctx);
/* Returns 1 if guard passes, 0 otherwise. All guards are expected to be written such that a passing guard allows the transition. */
typedef int (*{{ machine.name | lower }}_guard_t)({{ machine.name | lower }}_state_machine_t *state_machine, void *user_ctx);

/* A state table entry for the {{ machine.name | capitalize }} state machine. */
#define MAX_ACTIONS_PER_EVENT {{ max_actions }} // Arbitrary number to cap static allocation of actions in state table. Adjust as needed.
typedef struct
{
    /* The initial state for this table entry. */
    {{ machine.name | lower }}_state_t src;
    /* The event which triggers this table entry. */
    {{ machine.name | lower }}_event_t evt;
    /* The guard predicate for this entry, if any. */
    {{ machine.name | lower }}_guard_t guard;
    /* The action(s) taken by this table entry (in order of definition) in response to `event`. */
    {{ machine.name | lower }}_action_t actions[MAX_ACTIONS_PER_EVENT + 1];
    /* The state which the table entry places the state machine in after executing it's action(s). */
    {{ machine.name | lower }}_state_t tgt;
    /* The event to handle upon entering tgt, if any. */
    {{ machine.name | lower }}_event_t tgt_entry_evt;
} {{ machine.name | lower }}_state_table_entry_t;
{% endmacro %}