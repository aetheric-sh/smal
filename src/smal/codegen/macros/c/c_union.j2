{% macro c_union(union_spec) %}
typedef union
{
{% for tag_value, struct_name in union_spec.variants %}
    {{ struct_name | c_type_name }} {{ tag_value }}; // Payload for {{ tag_value }} entries
{% endfor %}
    uint32_t raw_words[2]; // For raw access to the payload as two 32-bit words, if needed
} {{ union_spec.name | c_type_name }};
{% endmacro %}