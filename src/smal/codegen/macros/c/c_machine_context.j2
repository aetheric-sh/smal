{% macro c_machine_context(machine) %}
typedef struct
{
{% for ctxvar in machine.context %}
    {{ctxvar.resolved_type | c_primitive_datatype}} {{ctxvar.name}}{{' = ' ~ ctxvar.resolved_type | c_primitive_value(ctxvar.resolved_value, machine.enum_specs) if ctxvar.default_value is defined}};
{% endfor %}
} {{ machine.name | lower }}_context_t;
{% endmacro %}